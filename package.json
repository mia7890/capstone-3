{
  "name": "loop-place-gadgets-ims",
  "version": "1.0.0",
  "description": "Loop Place Gadgets - Sales Analytics and Inventory Management System with Demand Forecasting (React 18 + Tailwind CSS + NestJS + TypeScript)",
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:client": "esbuild client/index.tsx --bundle --outfile=public/app.js --minify",
    "build": "npm run build:server && npm run build:client",
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node src/main.ts",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/serve-static": "^4.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
